FROM oven/bun:1.4.4 AS bun
FROM postgres:18.6-bookworm

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl unzip openssl tini util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 openms \
    && useradd --system --uid 10001 --gid openms --home-dir /app --no-create-home --shell /usr/sbin/nologin openms

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
COPY . .

# Build the matching, downloadable source before dependency installation. The
# Docker context excludes local assets, generated files, credentials and Git.
RUN chmod 0755 deploy/arcade/bootstrap.sh \
    && mkdir -p client/public/arcade \
    && tar --exclude='./.git' --exclude='./node_modules' \
      --exclude='*/node_modules' --exclude='*/generated' --exclude='*/.cache' \
      --exclude='*/dist' --exclude='./artifacts' --exclude='*/artifacts' \
      --exclude='./.env' --exclude='./.env.server' --exclude='./.env.client' \
      --exclude='./.env.studio' --exclude='*/secrets' --exclude='*.wz' \
      --exclude='./client/public/arcade/arcade-source.tar.gz' \
      -czf /tmp/arcade-source.tar.gz . \
    && mv /tmp/arcade-source.tar.gz client/public/arcade/arcade-source.tar.gz \
    && cp LICENSE client/public/arcade/arcade-LICENSE.txt \
    && bun install --frozen-lockfile \
    && printf '# Runtime values are injected by deploy/arcade/bootstrap.sh.\n' > .env.server \
    && printf '# Runtime values are injected by deploy/arcade/bootstrap.sh.\n' > .env.client \
    && chown -R openms:openms /app

ENV NODE_ENV=production \
    OPENMS_HOST=127.0.0.1 \
    OPENMS_PORT=3200 \
    OPENMS_ORIGIN=https://openms-arcade.fly.dev \
    OPENMS_SERVER_URL=http://127.0.0.1:3200 \
    ONLINE_HOST=0.0.0.0 \
    ONLINE_PORT=8080

EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/app/deploy/arcade/bootstrap.sh"]
